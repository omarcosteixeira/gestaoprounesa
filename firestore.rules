rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      let path1 = /databases/$(database)/documents/artifacts/gestaopro-761e1/public/data/users/$(request.auth.uid);
      let path2 = /databases/$(database)/documents/artifacts/gen-lang-client-0111023338/public/data/users/$(request.auth.uid);
      let path3 = /databases/$(database)/documents/artifacts/unesa-gestaopro/public/data/users/$(request.auth.uid);
      let path4 = /databases/$(database)/documents/artifacts/gestaodeleadspro-d4230/public/data/users/$(request.auth.uid);
      let path5 = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(path1) ? get(path1).data : (exists(path2) ? get(path2).data : (exists(path3) ? get(path3).data : (exists(path4) ? get(path4).data : (exists(path5) ? get(path5).data : {"role": "none", "unidade": "none"}))));
    }
    
    function isMasterUser() {
      let data = getUserData();
      return isAuthenticated() && (
        request.auth.token.email in ["canaldonutri@gmail.com", "marcos.teixeira@estacio.br"] || 
        data.email in ["canaldonutri@gmail.com", "marcos.teixeira@estacio.br"] ||
        data.role == "Admin Master" || 
        data.role == "Líder/FDV"
      );
    }
    
    function hasAnyRole(roles) {
      let data = getUserData();
      return isAuthenticated() && (
        isMasterUser() ||
        data.role in roles
      );
    }
    
    function isAdminMaster() { return hasAnyRole(['Admin Master']); }
    function isPrincipal() { return isAdminMaster(); }
    function isLider() { return hasAnyRole(['Líder/FDV']); }
    function isSalaMatricula() { return hasAnyRole(['Sala de Matrícula']); }
    function isQG() { return hasAnyRole(['QG']); }
    function isFDV() { return hasAnyRole(['FDV', 'FDV (Comercial)']); }
    function isPromotor() { return hasAnyRole(['Promotor', 'Promotor/rua']); }
    function isSSA() { return hasAnyRole(['SSA']); }
    function isGestorUnidade() { return hasAnyRole(['Gestor Unidade']); }
    function isGestorComercial() { return hasAnyRole(['Gestor Comercial', 'Gerente Comercial (Comercial)']); }
    function isComercial() { return isGestorComercial(); }
    function isAcademico() { return hasAnyRole(['Acadêmico']); }
    function isFinanceiro() { return hasAnyRole(['Financeiro']); }
    function isTecnico() { return hasAnyRole(['Técnico']); }
    function isRegional() { 
      let data = getUserData();
      return isAuthenticated() && data.role == 'Regional'; 
    }
    function isLiderSM() { return hasAnyRole(['Líder SM']); }
    function isGestor() { return hasAnyRole(['Gestor']); }
    function isSM() { return hasAnyRole(['SM']); }

    function isRestrictedRole(role) {
      return !(role in ['Admin Master', 'Gestor Comercial', 'Gerente Comercial (Comercial)', 'Financeiro', 'Regional', 'Gestor']);
    }

    function canAccessUnit(unidade) {
      let data = getUserData();
      return isMasterUser() || !isRestrictedRole(data.role) || (unidade == data.unidade);
    }

    // ===============================================================
    // Root Collection Rules
    // ===============================================================
    match /users/{userId} {
      allow get: if isAuthenticated();
      allow list: if isAuthenticated();
      allow create: if isAuthenticated() && (userId == request.auth.uid || isMasterUser() || isRegional());
      allow update: if isAuthenticated() && (isMasterUser() || isRegional() || (userId == request.auth.uid));
      allow delete: if isMasterUser() || isRegional();
    }
    
    match /unidades_regional/{id} { allow read, write: if isAuthenticated(); }
    match /funcionarios_sm/{id} { allow read, write: if isAuthenticated(); }
    match /tarefas/{id} { allow read, write: if isAuthenticated(); }
    match /checklist/{id} { allow read, write: if isAuthenticated(); }
    match /meta_dia/{id} { allow read, write: if isAuthenticated(); }
    match /meta_sm/{id} { allow read, write: if isAuthenticated(); }
    match /meta_cursos/{id} { allow read, write: if isAuthenticated(); }
    match /bom_dia/{id} { allow read, write: if isAuthenticated(); }
    match /meta_unidade_regional/{id} { allow read, write: if isAuthenticated(); }
    match /linksUteis/{id} { allow read, write: if isAuthenticated(); }
    match /planner/{id} { allow read, write: if isAuthenticated(); }
    match /periodo_captacao/{id} { allow read, write: if isAuthenticated(); }
    match /forecast/{id} { allow read, write: if isAuthenticated(); }
    match /cursos/{id} { allow read, write: if isAuthenticated(); }
    match /campanhas/{id} { allow read, write: if isAuthenticated(); }
    match /funcionarios/{id} { allow read, write: if isAuthenticated(); }
    match /formularios/{id} { allow read, write: if isAuthenticated(); }
    match /controle_concorrencia/{id} { allow read, write: if isAuthenticated(); }
    match /precos_instituicao/{id} { allow read, write: if isAuthenticated(); }
    match /evidencias_cliente_oculto/{id} { allow read, write: if isAuthenticated(); }
    match /crescimento_anual/{id} { allow read, write: if isAuthenticated(); }
    match /solicitacoes_folga/{id} { allow read, write: if isAuthenticated(); }
    match /qg_ligacoes/{id} { allow read, write: if isAuthenticated(); }
    match /clube_parceiros/{id} { allow read, write: if isAuthenticated(); }

    match /{collectionName}/{id} {
      allow read, write: if isAuthenticated() && (isMasterUser() || !isRegional());
    }

    // ===============================================================
    // Artifact Collection Rules - gestaopro-761e1
    // ===============================================================
    match /artifacts/gestaopro-761e1/public/data/users/{userId} {
      allow get: if isAuthenticated();
      allow list: if isAuthenticated();
      allow create: if isAuthenticated() && (userId == request.auth.uid || isMasterUser() || isRegional());
      allow update: if isAuthenticated() && (isMasterUser() || isRegional() || (userId == request.auth.uid));
      allow delete: if isMasterUser() || isRegional();
    }
    
    match /artifacts/gestaopro-761e1/public/data/unidades_regional/{id} { allow read, write: if isAuthenticated(); }
    match /artifacts/gestaopro-761e1/public/data/funcionarios_sm/{id} { allow read, write: if isAuthenticated(); }
    match /artifacts/gestaopro-761e1/public/data/tarefas/{id} { allow read, write: if isAuthenticated(); }
    match /artifacts/gestaopro-761e1/public/data/checklist/{id} { allow read, write: if isAuthenticated(); }
    match /artifacts/gestaopro-761e1/public/data/meta_dia/{id} { allow read, write: if isAuthenticated(); }
    match /artifacts/gestaopro-761e1/public/data/meta_sm/{id} { allow read, write: if isAuthenticated(); }
    match /artifacts/gestaopro-761e1/public/data/meta_cursos/{id} { allow read, write: if isAuthenticated(); }
    match /artifacts/gestaopro-761e1/public/data/bom_dia/{id} { allow read, write: if isAuthenticated(); }
    match /artifacts/gestaopro-761e1/public/data/meta_unidade_regional/{id} { allow read, write: if isAuthenticated(); }
    match /artifacts/gestaopro-761e1/public/data/linksUteis/{id} { allow read, write: if isAuthenticated(); }
    match /artifacts/gestaopro-761e1/public/data/planner/{id} { allow read, write: if isAuthenticated(); }
    match /artifacts/gestaopro-761e1/public/data/periodo_captacao/{id} { allow read, write: if isAuthenticated(); }
    match /artifacts/gestaopro-761e1/public/data/forecast/{id} { allow read, write: if isAuthenticated(); }
    match /artifacts/gestaopro-761e1/public/data/cursos/{id} { allow read, write: if isAuthenticated(); }
    match /artifacts/gestaopro-761e1/public/data/campanhas/{id} { allow read, write: if isAuthenticated(); }
    match /artifacts/gestaopro-761e1/public/data/funcionarios/{id} { allow read, write: if isAuthenticated(); }
    match /artifacts/gestaopro-761e1/public/data/formularios/{id} { allow read, write: if isAuthenticated(); }
    match /artifacts/gestaopro-761e1/public/data/controle_concorrencia/{id} { allow read, write: if isAuthenticated(); }
    match /artifacts/gestaopro-761e1/public/data/precos_instituicao/{id} { allow read, write: if isAuthenticated(); }
    match /artifacts/gestaopro-761e1/public/data/evidencias_cliente_oculto/{id} { allow read, write: if isAuthenticated(); }
    match /artifacts/gestaopro-761e1/public/data/crescimento_anual/{id} { allow read, write: if isAuthenticated(); }
    match /artifacts/gestaopro-761e1/public/data/solicitacoes_folga/{id} { allow read, write: if isAuthenticated(); }
    match /artifacts/gestaopro-761e1/public/data/qg_ligacoes/{id} { allow read, write: if isAuthenticated(); }
    match /artifacts/gestaopro-761e1/public/data/clube_parceiros/{id} { allow read, write: if isAuthenticated(); }

    match /artifacts/gestaopro-761e1/public/data/clube_resgates/{id} { allow read, write: if true; }
    match /artifacts/gestaopro-761e1/public/data/{collectionName}/{id} {
      allow read, write: if isAuthenticated() && (isMasterUser() || !isRegional());
    }

    // ===============================================================
    // Artifact Collection Rules - unesa-gestaopro
    // ===============================================================
    match /artifacts/unesa-gestaopro/public/data/users/{userId} {
      allow get: if isAuthenticated();
      allow list: if isAuthenticated();
      allow create: if isAuthenticated() && (userId == request.auth.uid || isMasterUser() || isRegional());
      allow update: if isAuthenticated() && (isMasterUser() || isRegional() || (userId == request.auth.uid));
      allow delete: if isMasterUser() || isRegional();
    }
    
    match /artifacts/unesa-gestaopro/public/data/unidades_regional/{id} { allow read, write: if isAuthenticated(); }
    match /artifacts/unesa-gestaopro/public/data/funcionarios_sm/{id} { allow read, write: if isAuthenticated(); }
    match /artifacts/unesa-gestaopro/public/data/tarefas/{id} { allow read, write: if isAuthenticated(); }
    match /artifacts/unesa-gestaopro/public/data/checklist/{id} { allow read, write: if isAuthenticated(); }
    match /artifacts/unesa-gestaopro/public/data/meta_dia/{id} { allow read, write: if isAuthenticated(); }
    match /artifacts/unesa-gestaopro/public/data/meta_sm/{id} { allow read, write: if isAuthenticated(); }
    match /artifacts/unesa-gestaopro/public/data/meta_cursos/{id} { allow read, write: if isAuthenticated(); }
    match /artifacts/unesa-gestaopro/public/data/bom_dia/{id} { allow read, write: if isAuthenticated(); }
    match /artifacts/unesa-gestaopro/public/data/meta_unidade_regional/{id} { allow read, write: if isAuthenticated(); }
    match /artifacts/unesa-gestaopro/public/data/linksUteis/{id} { allow read, write: if isAuthenticated(); }
    match /artifacts/unesa-gestaopro/public/data/planner/{id} { allow read, write: if isAuthenticated(); }
    match /artifacts/unesa-gestaopro/public/data/periodo_captacao/{id} { allow read, write: if isAuthenticated(); }
    match /artifacts/unesa-gestaopro/public/data/forecast/{id} { allow read, write: if isAuthenticated(); }
    match /artifacts/unesa-gestaopro/public/data/cursos/{id} { allow read, write: if isAuthenticated(); }
    match /artifacts/unesa-gestaopro/public/data/campanhas/{id} { allow read, write: if isAuthenticated(); }
    match /artifacts/unesa-gestaopro/public/data/funcionarios/{id} { allow read, write: if isAuthenticated(); }
    match /artifacts/unesa-gestaopro/public/data/formularios/{id} { allow read, write: if isAuthenticated(); }
    match /artifacts/unesa-gestaopro/public/data/controle_concorrencia/{id} { allow read, write: if isAuthenticated(); }
    match /artifacts/unesa-gestaopro/public/data/precos_instituicao/{id} { allow read, write: if isAuthenticated(); }
    match /artifacts/unesa-gestaopro/public/data/evidencias_cliente_oculto/{id} { allow read, write: if isAuthenticated(); }
    match /artifacts/unesa-gestaopro/public/data/crescimento_anual/{id} { allow read, write: if isAuthenticated(); }
    match /artifacts/unesa-gestaopro/public/data/solicitacoes_folga/{id} { allow read, write: if isAuthenticated(); }
    match /artifacts/unesa-gestaopro/public/data/qg_ligacoes/{id} { allow read, write: if isAuthenticated(); }
    match /artifacts/unesa-gestaopro/public/data/clube_parceiros/{id} { allow read, write: if isAuthenticated(); }

    match /artifacts/unesa-gestaopro/public/data/clube_resgates/{id} { allow read, write: if true; }
    match /artifacts/unesa-gestaopro/public/data/{collectionName}/{id} {
      allow read, write: if isAuthenticated() && (isMasterUser() || !isRegional());
    }

    // ===============================================================
    // Artifact Collection Rules - gestaodeleadspro-d4230
    // ===============================================================
    match /artifacts/gestaodeleadspro-d4230/public/data/users/{userId} {
      allow get: if isAuthenticated();
      allow list: if isAuthenticated();
      allow create: if isAuthenticated() && (userId == request.auth.uid || isMasterUser() || isRegional());
      allow update: if isAuthenticated() && (isMasterUser() || isRegional() || (userId == request.auth.uid));
      allow delete: if isMasterUser() || isRegional();
    }
    
    match /artifacts/gestaodeleadspro-d4230/public/data/unidades_regional/{id} { allow read, write: if isAuthenticated(); }
    match /artifacts/gestaodeleadspro-d4230/public/data/funcionarios_sm/{id} { allow read, write: if isAuthenticated(); }
    match /artifacts/gestaodeleadspro-d4230/public/data/tarefas/{id} { allow read, write: if isAuthenticated(); }
    match /artifacts/gestaodeleadspro-d4230/public/data/checklist/{id} { allow read, write: if isAuthenticated(); }
    match /artifacts/gestaodeleadspro-d4230/public/data/meta_dia/{id} { allow read, write: if isAuthenticated(); }
    match /artifacts/gestaodeleadspro-d4230/public/data/meta_sm/{id} { allow read, write: if isAuthenticated(); }
    match /artifacts/gestaodeleadspro-d4230/public/data/meta_cursos/{id} { allow read, write: if isAuthenticated(); }
    match /artifacts/gestaodeleadspro-d4230/public/data/bom_dia/{id} { allow read, write: if isAuthenticated(); }
    match /artifacts/gestaodeleadspro-d4230/public/data/meta_unidade_regional/{id} { allow read, write: if isAuthenticated(); }
    match /artifacts/gestaodeleadspro-d4230/public/data/linksUteis/{id} { allow read, write: if isAuthenticated(); }
    match /artifacts/gestaodeleadspro-d4230/public/data/planner/{id} { allow read, write: if isAuthenticated(); }
    match /artifacts/gestaodeleadspro-d4230/public/data/periodo_captacao/{id} { allow read, write: if isAuthenticated(); }
    match /artifacts/gestaodeleadspro-d4230/public/data/forecast/{id} { allow read, write: if isAuthenticated(); }
    match /artifacts/gestaodeleadspro-d4230/public/data/cursos/{id} { allow read, write: if isAuthenticated(); }
    match /artifacts/gestaodeleadspro-d4230/public/data/campanhas/{id} { allow read, write: if isAuthenticated(); }
    match /artifacts/gestaodeleadspro-d4230/public/data/funcionarios/{id} { allow read, write: if isAuthenticated(); }
    match /artifacts/gestaodeleadspro-d4230/public/data/formularios/{id} { allow read, write: if isAuthenticated(); }
    match /artifacts/gestaodeleadspro-d4230/public/data/controle_concorrencia/{id} { allow read, write: if isAuthenticated(); }
    match /artifacts/gestaodeleadspro-d4230/public/data/precos_instituicao/{id} { allow read, write: if isAuthenticated(); }
    match /artifacts/gestaodeleadspro-d4230/public/data/evidencias_cliente_oculto/{id} { allow read, write: if isAuthenticated(); }
    match /artifacts/gestaodeleadspro-d4230/public/data/crescimento_anual/{id} { allow read, write: if isAuthenticated(); }
    match /artifacts/gestaodeleadspro-d4230/public/data/solicitacoes_folga/{id} { allow read, write: if isAuthenticated(); }
    match /artifacts/gestaodeleadspro-d4230/public/data/qg_ligacoes/{id} { allow read, write: if isAuthenticated(); }
    match /artifacts/gestaodeleadspro-d4230/public/data/clube_parceiros/{id} { allow read, write: if isAuthenticated(); }

    match /artifacts/gestaodeleadspro-d4230/public/data/clube_resgates/{id} { allow read, write: if true; }
    match /artifacts/gestaodeleadspro-d4230/public/data/{collectionName}/{id} {
      allow read, write: if isAuthenticated() && (isMasterUser() || !isRegional());
    }
    
    // ===============================================================
    // Artifact Collection Rules - gen-lang-client-0111023338
    // ===============================================================
    match /artifacts/gen-lang-client-0111023338/public/data/users/{userId} {
      allow get: if isAuthenticated();
      allow list: if isAuthenticated();
      allow create: if isAuthenticated() && (userId == request.auth.uid || isMasterUser() || isRegional());
      allow update: if isAuthenticated() && (isMasterUser() || isRegional() || (userId == request.auth.uid));
      allow delete: if isMasterUser() || isRegional();
    }
    
    match /artifacts/gen-lang-client-0111023338/public/data/unidades_regional/{id} { allow read, write: if isAuthenticated(); }
    match /artifacts/gen-lang-client-0111023338/public/data/funcionarios_sm/{id} { allow read, write: if isAuthenticated(); }
